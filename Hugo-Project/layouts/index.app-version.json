{{- $cat := partial "catalog.html" .Site -}}
{{- $rel := .Site.Data.app_release | default dict -}}
{{- dict "appId" ($rel.appId | default "com.csrgo.telugustates.fieldtest") "versionCode" ($rel.versionCode | default 71500) "versionName" ($rel.versionName | default "7.15.0") "engineHash" ($rel.engineHash | default "") "contentHash" (sha256 $cat) "houses" (len (where .Site.RegularPages "Section" "houses")) "apkUrl" ($rel.apkUrl | default "https://github.com/srikanth1815101/telugustates/releases/latest/download/Telugu-States-Atlas.apk") "releaseMetaUrl" ($rel.releaseMetaUrl | default "https://github.com/srikanth1815101/telugustates/releases/latest/download/app-version.json") "domains" ($rel.domains | default (slice "https://telugustates.csrgo.com" "https://telugustates.netlify.app")) "catalogPath" "/catalog.json" | jsonify -}}
