{
  "name": "telugu-states",
  "private": true,
  "type": "module",
  "description": "Build and test tooling for the Telugu States atlas. The site itself stays dependency-free at runtime: Vite bundles static/js into static/dist, Hugo renders content, and every runtime file is served locally.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:site",
    "build:js": "vite build",
    "build:site": "hugo --source Hugo-Project --minify",
    "dev:js": "vite build --watch",
    "dev:site": "hugo server --source Hugo-Project",
    "typecheck": "tsc -p tsconfig.json",
    "test:checks": "node Hugo-Project/tools/run-all.mjs",
    "test:e2e": "node e2e/smoke.mjs",
    "test": "npm run typecheck && npm run test:checks && npm run test:e2e"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.161",
    "@sparticuz/chromium": "^158.0.0",
    "fake-indexeddb": "^6.2.8",
    "meshoptimizer": "^1.3.0",
    "puppeteer-core": "^25.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "bitecs": "^0.4.0",
    "idb": "^8.0.4",
    "postprocessing": "^6.39.6",
    "three-mesh-bvh": "^0.10.0",
    "yuka": "^0.7.8"
  }
}
